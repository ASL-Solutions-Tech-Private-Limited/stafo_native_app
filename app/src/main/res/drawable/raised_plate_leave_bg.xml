<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <solid android:color="#67FF746C" /> <!-- Your blue background -->
            <corners android:radius="16dp" />
            <padding
                android:bottom="@dimen/_1sdp"
                android:left="@dimen/_1sdp"
                android:right="@dimen/_1sdp"
                android:top="@dimen/_1sdp"/>
        </shape>
    </item>


    <item
        android:bottom="@dimen/_1sdp"
        android:left="@dimen/_1sdp"
        android:right="@dimen/_1sdp"
        android:top="@dimen/_1sdp">
        <shape android:shape="rectangle">
            <solid android:color="@color/pastel_red" /> <!-- Slightly darker for depth illusion -->
            <corners android:radius="14dp" />
        </shape>
    </item>
</layer-list>
