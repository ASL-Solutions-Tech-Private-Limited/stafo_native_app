<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_6sdp"
        android:layout_marginBottom="@dimen/_2sdp"
        android:layout_marginHorizontal="@dimen/_2sdp"
        app:cardCornerRadius="@dimen/_12sdp"
        app:cardElevation="@dimen/_2sdp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:id="@+id/card_view"
            android:padding="@dimen/_12sdp">

            <!-- Lead Name + Date -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvLeadName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/gilroy_semi_bold"
                    android:text="John Doe"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_14ssp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvFollowUpDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/gilroy_medium"
                    android:text="May 9, 2025"
                    android:textColor="@color/gray_colour"
                    android:textSize="@dimen/_10ssp" />
            </LinearLayout>

            <!-- Company / Contact Info -->
            <TextView
                android:id="@+id/tvLeadCompany"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:fontFamily="@font/gilroy_medium"
                android:text="XYZ Pvt Ltd"
                android:textColor="@color/gray_colour"
                android:textSize="@dimen/_11ssp" />

            <!-- Follow-up Notes -->
            <TextView
                android:id="@+id/tvFollowUpNote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gilroy_semi_bold"
                android:padding="@dimen/_2sdp"
                android:text="Call to confirm budget and send proposal."
                android:textColor="@color/colorPrimaryDark"
                android:textSize="@dimen/_11ssp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>
