<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <RelativeLayout
        android:id="@+id/rl_emp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_5sdp"
        android:layout_marginEnd="@dimen/_10sdp"
        android:layout_marginBottom="@dimen/_5sdp"
        android:background="@drawable/custom_item_card_bg"
        android:padding="@dimen/_10sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">


        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/item_delete"
            android:src="@drawable/delete"
            android:tint="@color/pastel_red"
            app:shapeAppearanceOverlay="@style/Circular"
            android:background="@color/tea_green"
            app:contentPadding="@dimen/_3sdp"
            android:layout_alignParentEnd="true"
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"/>


        <TextView
            android:id="@+id/txt_branch_name1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:fontFamily="@font/gilroy_medium"
            android:text="Branch Name"
            android:singleLine="true"
            android:textColor="@color/black"
            android:textSize="@dimen/_12ssp" />


        <TextView
            android:id="@+id/txt_branch_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toLeftOf="@+id/item_delete"
            android:layout_marginStart="@dimen/_6sdp"
            android:layout_toRightOf="@+id/txt_branch_name1"
            android:fontFamily="@font/gilroy_regular"
            android:text=""
            android:singleLine="true"
            android:textColor="@color/black"
            android:textSize="@dimen/_12ssp" />

        <TextView
            android:id="@+id/txt_branch_address1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/txt_branch_name"
            android:layout_alignParentStart="true"
            android:layout_marginTop="@dimen/_9sdp"
            android:fontFamily="@font/gilroy_medium"
            android:text="Address"
            android:singleLine="true"
            android:textColor="@color/black"
            android:textSize="@dimen/_12ssp" />

        <TextView
            android:id="@+id/txt_branch_address"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/txt_branch_name"
            android:layout_alignStart="@+id/txt_branch_name"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="@dimen/_9sdp"
            android:fontFamily="@font/gilroy_regular"
            android:text=""
            android:maxLines="2"
            android:textColor="@color/black"
            android:textSize="@dimen/_12ssp" />





    </RelativeLayout>


</androidx.constraintlayout.widget.ConstraintLayout>