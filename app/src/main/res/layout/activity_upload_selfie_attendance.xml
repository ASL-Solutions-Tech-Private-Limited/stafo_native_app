<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".screens.settings.UploadSelfieAttendanceActivity">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/colorTextPrimary"
        app:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            tools:ignore="UseCompoundDrawables">


            <ImageView
                android:id="@+id/image_back"
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/_8sdp"
                android:scaleType="fitXY"
                android:src="@drawable/ic_back"
                android:tint="@color/white"
                tools:ignore="UseAppTint" />


            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:fontFamily="@font/gilroy_semi_bold"
                android:text="Upload Selfie Image"
                android:textColor="@color/white"
                android:textSize="@dimen/_14ssp" />


        </RelativeLayout>


    </com.google.android.material.appbar.AppBarLayout>

    <RelativeLayout
        android:id="@+id/rl_selfie_punch_in"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_270sdp"
        android:background="@color/tea_green"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@id/app_bar_layout">



        <TextView
            android:id="@+id/tv_upload_selfie"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/custom_view_profile_bg"
          android:paddingVertical="@dimen/_4sdp"
            android:paddingHorizontal="@dimen/_8sdp"
            android:layout_centerInParent="true"
            android:layout_marginTop="@dimen/_6sdp"
            android:fontFamily="@font/poppins_regular"
            android:text="Upload Selfie"
            android:textColor="@color/blue"
            android:textSize="@dimen/_12ssp" />






        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/siv_emp_punch"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            android:background="@color/white"
            android:scaleType="fitXY"
            android:visibility="gone" />
        <com.google.android.material.imageview.ShapeableImageView
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="@dimen/_12sdp"
            android:layout_marginBottom="@dimen/_12sdp"
            android:id="@+id/tv_retake_selfie"
            android:visibility="gone"
            app:shapeAppearanceOverlay="@style/Circular"
            android:background="@color/tea_green"
            app:contentPadding="@dimen/_6sdp"
            android:elevation="@dimen/_3sdp"
            android:layout_width="@dimen/_28sdp"
            android:layout_height="@dimen/_28sdp"
            android:src="@drawable/ic_take_selfie" />


    </RelativeLayout>


    <Button
        android:id="@+id/btn_upload_selfie"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_12sdp"
        android:layout_marginTop="@dimen/_24sdp"
        android:layout_marginBottom="@dimen/_80sdp"
        android:background="@drawable/button_background"
        android:text="Submit"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rl_selfie_punch_in" />
</androidx.constraintlayout.widget.ConstraintLayout>