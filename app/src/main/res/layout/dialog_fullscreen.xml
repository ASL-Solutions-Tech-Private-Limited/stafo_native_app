<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:gravity="center"
    android:orientation="vertical">

    <TextView
        android:id="@+id/dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_12sdp"
        android:fontFamily="@font/gilroy_medium"
        android:maxLines="3"
        android:text="Allow STAFO APP to access\nthis device's location all the\ntime?"
        android:textAlignment="center"
        android:textColor="@color/black"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/dialog_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_12sdp"
        android:fontFamily="@font/gilroy_regular"
        android:justificationMode="inter_word"
        android:paddingVertical="@dimen/_12sdp"
        android:text="This app  needs background location access to confirm your presence at designated work locations, even when the app is closed. This ensures automated check-ins, accurate attendance records, and compliance with company policies"
        android:textAlignment="center"
        android:textColor="@color/black"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btn_allow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="@android:color/holo_blue_dark"
        android:fontFamily="@font/gilroy_regular"
        android:padding="12dp"
        android:text="Allow"
        android:textColor="@android:color/white" />

    <Button
        android:id="@+id/btn_deny"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:backgroundTint="@android:color/darker_gray"
        android:fontFamily="@font/gilroy_regular"
        android:padding="12dp"
        android:text="Deny"
        android:textColor="@android:color/white" />
</LinearLayout>
