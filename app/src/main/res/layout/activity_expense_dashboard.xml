<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="@drawable/gradient_header"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".screens.expense.ExpenseDashboardActivity">


    <LinearLayout
        android:id="@+id/llc_title"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_12sdp"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/_4sdp"
            android:src="@drawable/ic_back" />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_12sdp"
            android:fontFamily="@font/gilroy_semi_bold"
            android:padding="@dimen/_6sdp"
            android:text="Expense Dashboard"
            android:textColor="@color/white"
            android:textSize="@dimen/_12ssp" />
    </LinearLayout>






    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddExpense"
        android:layout_width="@dimen/_38sdp"
        android:layout_height="@dimen/_38sdp"
        android:layout_marginEnd="@dimen/_12sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@+id/llc_title"
        android:backgroundTint="@color/primaryColorDark"
        android:gravity="center"
        android:text="+"
        android:textColor="@color/white"
        android:textSize="@dimen/_14ssp"
        app:cornerRadius="@dimen/_6sdp"/>






    <androidx.constraintlayout.widget.ConstraintLayout
        app:layout_constraintTop_toBottomOf="@+id/llc_title"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="@drawable/top_rounded_bg"
        android:layout_marginTop="@dimen/_14sdp"
        android:layout_width="match_parent"
        android:layout_height="0dp">

        <HorizontalScrollView
            android:id="@+id/hsv_tap"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginTop="@dimen/_12sdp"
            android:layout_marginHorizontal="@dimen/_4sdp"
            android:orientation="horizontal"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">


                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_all_tasks"
                    android:layout_width="@dimen/_100sdp"
                    android:layout_height="@dimen/_38sdp"
                    android:layout_margin="@dimen/_2sdp"
                    android:background="@drawable/card_rtl_bg_offer"
                    android:fontFamily="@font/gilroy_semi_bold"
                    android:gravity="center"
                    android:text="All Expenses"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_11ssp"
                   />


                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_pending"
                    android:layout_width="@dimen/_100sdp"
                    android:layout_height="@dimen/_34sdp"
                    android:layout_margin="@dimen/_2sdp"
                    android:background="@drawable/card_rtl_bg_offer"
                    android:fontFamily="@font/gilroy_semi_bold"
                    android:gravity="center"
                    android:text="Pending"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_11ssp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_completed"
                    android:layout_width="@dimen/_100sdp"
                    android:layout_height="@dimen/_34sdp"
                    android:layout_margin="@dimen/_2sdp"
                    android:background="@drawable/card_rtl_bg_offer"
                    android:fontFamily="@font/gilroy_semi_bold"
                    android:gravity="center"
                    android:text="Completed"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_11ssp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_rejected"
                    android:layout_width="@dimen/_100sdp"
                    android:layout_height="@dimen/_34sdp"
                    android:layout_margin="@dimen/_2sdp"
                    android:background="@drawable/card_rtl_bg_offer"
                    android:fontFamily="@font/gilroy_semi_bold"
                    android:gravity="center"
                    android:text="Rejected"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_11ssp"
                    android:textStyle="bold" />
            </LinearLayout>
        </HorizontalScrollView>



        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshLayout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/hsv_tap"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/_8sdp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_show_apply_expense"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="@dimen/_10sdp"
                android:layout_below="@+id/include_01"
                tools:listitem="@layout/recy_branch_item_layout"/>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <TextView
            android:id="@+id/txt_msg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/hsv_tap"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginHorizontal="@dimen/_12sdp"
            android:gravity="center"
            android:fontFamily="@font/gilroy_regular"
            android:text="No records under this status."
            android:textColor="@color/black"
            android:textSize="@dimen/_12ssp"
            android:visibility="gone" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>