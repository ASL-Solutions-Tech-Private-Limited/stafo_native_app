<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="12dp">

    <!-- Vertical line and dot indicator -->
    <LinearLayout
        android:layout_width="40dp"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <View
            android:id="@+id/stepIndicator"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_dot_blue" />

        <View
            android:id="@+id/stepLine"
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:background="#CCC" />
    </LinearLayout>

    <!-- Content: Location and Time -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/stepLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Halt Location"
            android:textColor="#333"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/stepTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="10:45 AM - 11:20 AM"
            android:textColor="#666"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
