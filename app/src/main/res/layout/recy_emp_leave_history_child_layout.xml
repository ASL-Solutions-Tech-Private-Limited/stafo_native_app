<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent">

    <androidx.cardview.widget.CardView
        android:id="@+id/card_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_10sdp"
        android:layout_marginTop="10dp"
        android:background="@drawable/custom_card_background"
        app:cardCornerRadius="6dp"
        app:cardElevation="0dp">

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/txt_employee_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Personal"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txt_leave_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_8sdp"
                android:layout_below="@+id/txt_employee_name"
                android:layout_marginTop="@dimen/_10sdp"
                android:fontFamily="@font/gilroy_medium"
                android:text="Annual Leave"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txt_rqst_dt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/txt_leave_type"
                android:layout_alignStart="@+id/txt_leave_type"
                android:layout_marginTop="5dip"
                android:ellipsize="end"
                android:fontFamily="@font/gilroy_regular"
                android:maxLength="28"
                android:text="18/09/2024 - 24-09-2024"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txt_days"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/txt_rqst_dt"
                android:layout_alignStart="@+id/txt_rqst_dt"
                android:layout_marginTop="5dip"
                android:fontFamily="@font/gilroy_regular"
                android:text="6.00 Days "
                android:textColor="@color/black"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txt_status"
                android:layout_marginEnd="@dimen/_8sdp"
                android:layout_marginBottom="@dimen/_10sdp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/txt_rqst_dt"
               android:layout_alignParentEnd="true"
                android:layout_marginTop="5dip"
                android:fontFamily="@font/gilroy_regular"
                android:text="Pending"
                android:textColor="@color/black"
                android:textSize="14sp" />


        </RelativeLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>