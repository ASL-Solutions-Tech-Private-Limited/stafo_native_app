<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".screens.EmpLeaveActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/primaryColorDark"
        app:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            tools:ignore="UseCompoundDrawables">


            <ImageView
                android:id="@+id/image_back"
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/_8sdp"
                android:scaleType="fitXY"
                android:src="@drawable/ic_back"
                android:tint="@color/white"
                tools:ignore="UseAppTint" />


            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:fontFamily="@font/gilroy_semi_bold"
                android:text="Apply Leave"
                android:textColor="@color/white"
                android:textSize="@dimen/_14ssp" />

            <ImageView
                android:id="@+id/image_settings"
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/_4sdp"
                android:scaleType="fitXY"
                android:src="@drawable/drop_down_menu"
                android:tint="@color/white"
                tools:ignore="UseAppTint" />

        </RelativeLayout>

    </com.google.android.material.appbar.AppBarLayout>


    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="@dimen/_16sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/app_bar_layout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="10dp">

         <!--   <LinearLayout
                android:id="@+id/scrollrelative"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_marginStart="5dp"
                android:visibility="gone"
                android:layout_marginEnd="5dp"
                android:orientation="vertical"
                android:paddingBottom="10dp">


                <RelativeLayout
                    android:id="@+id/rl_spn_subordinate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="visible">

                    <Spinner
                        android:id="@+id/spinner_leave_type"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_36sdp"
                        android:layout_marginHorizontal="@dimen/_10sdp"
                        android:background="@drawable/edit_text_background"
                        android:dropDownVerticalOffset="@dimen/_34sdp"
                        android:gravity="center_vertical"
                        android:paddingLeft="5dip"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_12ssp" />

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="@dimen/_16sdp"
                        android:background="@android:color/transparent"
                        android:src="@drawable/ic_arrow_down"
                        android:tint="@color/black"
                        tools:ignore="UseAppTint" />
                </RelativeLayout>


                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/edt_from_date"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_36sdp"
                    android:layout_marginHorizontal="@dimen/_10sdp"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:focusableInTouchMode="false"
                    android:focusable="false"
                    android:background="@drawable/edit_text_background"
                    android:drawableRight="@drawable/ic_calendar_month"
                    android:fontFamily="@font/gilroy_regular"
                    android:gravity="center_vertical"
                    android:hint="From Date"
                    android:paddingHorizontal="@dimen/_10sdp"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_12ssp" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/edt_to_date"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_36sdp"
                    android:layout_marginHorizontal="@dimen/_10sdp"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:focusableInTouchMode="false"
                    android:focusable="false"
                    android:background="@drawable/edit_text_background"
                    android:drawableRight="@drawable/ic_calendar_month"
                    android:fontFamily="@font/gilroy_regular"
                    android:gravity="center_vertical"
                    android:hint="To Date"
                    android:paddingHorizontal="@dimen/_10sdp"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_12ssp" />

                <RadioGroup
                    android:id="@+id/rg_leav"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:orientation="horizontal"
                    android:padding="2dp">

                    <RadioButton
                        android:id="@+id/rd_full_leave"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="1dp"
                        android:layout_weight="1"
                        android:button="@drawable/custom_radio_button"
                        android:checked="true"
                        android:gravity="center"
                        android:text="    Full Day"
                        android:textColor="@color/black"
                        android:textSize="12sp" />

                    <RadioButton
                        android:id="@+id/rd_half_leave"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="30dp"
                        android:layout_weight="1"
                        android:button="@drawable/custom_radio_button"
                        android:checked="false"
                        android:gravity="center"
                        android:text="    Half Day"
                        android:textColor="@color/black"
                        android:textSize="12sp" />
                </RadioGroup>

                <TextView
                    android:id="@+id/nod_txt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:gravity="center_vertical"
                    android:hint="No of leave : 0 days"
                    android:paddingLeft="5dip"
                    android:textColor="@color/black"
                    android:textSize="14sp" />


                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/edt_description"
                    android:layout_width="match_parent"
                    android:layout_height="80dip"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:background="@drawable/edit_text_background"
                    android:gravity="left|top"
                    android:hint="Descriptions"
                    android:paddingHorizontal="@dimen/_8sdp"
                    android:paddingVertical="@dimen/_6sdp"
                    android:textColor="@color/black"
                    android:textSize="14dip" />


                <Button
                    android:id="@+id/btn_leave"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_36sdp"
                    android:layout_marginHorizontal="@dimen/_10sdp"
                    android:layout_marginTop="@dimen/_20sdp"
                    android:layout_marginBottom="@dimen/_10sdp"
                    android:background="@drawable/button_background"
                    android:text="Submit"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="16sp" />




            </LinearLayout>-->

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/llc_first"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_10sdp"
                android:layout_marginTop="12dp"
                android:background="@drawable/rounded_corner_white"
                android:orientation="vertical"
                app:layout_constraintTop_toBottomOf="@+id/llc_leave_list">



                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/txt_leave_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:text="Leave Type"
                    android:textColor="@color/black"
                    android:textSize="14sp" />

                <RelativeLayout
                    android:layout_marginTop="@dimen/_6sdp"
                    android:id="@+id/rl_spn_subordinate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="visible">

                    <Spinner
                        android:id="@+id/spinner_leave_type"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_36sdp"
                        android:background="@drawable/edit_text_background"
                        android:dropDownVerticalOffset="@dimen/_34sdp"
                        android:gravity="center_vertical"
                        android:paddingLeft="5dip"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_12ssp" />

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="@dimen/_16sdp"
                        android:background="@android:color/transparent"
                        android:src="@drawable/ic_arrow_down"
                        android:tint="@color/black"
                        tools:ignore="UseAppTint" />
                </RelativeLayout>

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:weightSum="1">

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.5"
                        android:orientation="vertical">


                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tv_start_date"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginTop="16dp"
                            android:fontFamily="@font/poppins_regular"
                            android:text="Start date:"
                            android:textColor="@color/black"
                            android:textSize="14sp" />


                        <androidx.appcompat.widget.AppCompatEditText
                            android:id="@+id/edt_from_date"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_36sdp"
                            android:layout_marginTop="@dimen/_6sdp"
                            android:focusableInTouchMode="false"
                            android:focusable="false"
                            android:background="@drawable/edit_text_background"
                            android:drawableRight="@drawable/ic_calendar_month"
                            android:fontFamily="@font/gilroy_regular"
                            android:gravity="center_vertical"
                            android:hint="From Date"
                            android:paddingHorizontal="@dimen/_10sdp"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_12ssp" />



                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:layout_weight="0.5"
                        android:orientation="vertical">

                        <!--<androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tv_end_date"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginTop="12dp"
                            android:gravity="center_vertical"
                            android:hint="End date:"
                            android:textColor="@color/black"
                            android:textSize="14sp" />-->

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tv_end_date"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginTop="16dp"
                            android:fontFamily="@font/poppins_regular"
                            android:text="End date:"
                            android:textColor="@color/black"
                            android:textSize="14sp" />

                        <androidx.appcompat.widget.AppCompatEditText
                            android:id="@+id/edt_to_date"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_36sdp"
                            android:layout_marginTop="@dimen/_6sdp"
                            android:focusableInTouchMode="false"
                            android:focusable="false"
                            android:background="@drawable/edit_text_background"
                            android:drawableRight="@drawable/ic_calendar_month"
                            android:fontFamily="@font/gilroy_regular"
                            android:gravity="center_vertical"
                            android:hint="To Date"
                            android:paddingHorizontal="@dimen/_10sdp"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_12ssp" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                </androidx.appcompat.widget.LinearLayoutCompat>

                <RadioGroup
                    android:id="@+id/rg_leave"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    android:padding="2dp">

                    <RadioButton
                        android:id="@+id/rd_full_leave"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="1dp"
                        android:layout_weight="1"
                        android:button="@drawable/custom_radio_button"
                        android:checked="true"
                        android:fontFamily="@font/poppins_regular"
                        android:gravity="center"
                        android:text="Full day"
                        android:textColor="@color/black"
                        android:textSize="12sp" />

                    <RadioButton
                        android:id="@+id/rd_half_leave"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="12dp"
                        android:layout_weight="1"
                        android:button="@drawable/custom_radio_button"
                        android:checked="false"
                        android:fontFamily="@font/poppins_regular"
                        android:gravity="center"
                        android:text="Half day"
                        android:textColor="@color/black"
                        android:textSize="12sp" />
                </RadioGroup>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/nod_Txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/poppins_regular"
                    android:text="No of leave : 0 days"
                    android:textColor="@color/black"
                    android:textSize="14sp" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_comments"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/poppins_regular"
                    android:text="Description"
                    android:textColor="@color/black"
                    android:textSize="14sp" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/edt_description"
                    android:layout_width="match_parent"
                    android:layout_height="80dip"
                    android:layout_marginTop="@dimen/_6sdp"
                    android:background="@drawable/edit_text_background"
                    android:gravity="left|top"
                    android:hint="Descriptions"
                    android:paddingHorizontal="@dimen/_8sdp"
                    android:paddingVertical="@dimen/_6sdp"
                    android:textColor="@color/black"
                    android:textSize="14dip" />

            </androidx.appcompat.widget.LinearLayoutCompat>


            <Button
                android:id="@+id/btn_leave"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_36sdp"
                android:layout_marginTop="@dimen/_20sdp"
                android:layout_marginBottom="@dimen/_10sdp"
                android:layout_marginHorizontal="@dimen/_10sdp"
                android:background="@drawable/button_background"
                android:text="Submit"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp" />


        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>