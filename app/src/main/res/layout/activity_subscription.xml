        </RadioGroup>-->
    </LinearLayout>


    <RelativeLayout
        android:id="@+id/rtl_monthly"
        android:elevation="@dimen/_3sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:padding="@dimen/_12sdp"
        android:visibility="visible"
        android:paddingHorizontal="@dimen/_10sdp"
        app:layout_constraintTop_toBottomOf="@+id/ll_tab"
        android:layout_marginTop="@dimen/_16sdp"
        android:layout_marginHorizontal="@dimen/_12sdp"
        android:background="@drawable/custom_card_bg2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">


        <LinearLayout
            android:id="@+id/llc_price"
            android:layout_centerHorizontal="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            >

            <TextView
                android:text="Price: "
                android:textColor="@color/black"
                android:textSize="@dimen/_14ssp"
                android:fontFamily="@font/gilroy_semi_bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:id="@+id/tv_price"
                android:textColor="@color/black"
                android:textSize="@dimen/_14ssp"
                android:fontFamily="@font/gilroy_semi_bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llc_duration"
            android:layout_marginTop="@dimen/_2sdp"
            android:layout_below="@+id/llc_price"
            android:layout_centerHorizontal="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            >
            <TextView
                android:text="Duration: "
                android:textColor="@color/black"
                android:textSize="@dimen/_11ssp"
                android:fontFamily="@font/gilroy_regular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:id="@+id/tv_duration"

                android:textColor="@color/black"
                android:textSize="@dimen/_11ssp"
                android:fontFamily="@font/gilroy_regular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>






        <androidx.recyclerview.widget.RecyclerView
            android:layout_below="@+id/llc_price"
            android:id="@+id/rv_feature_list"
            android:layout_marginTop="@dimen/_20sdp"
            android:layout_marginBottom="@dimen/_12sdp"
            tools:listitem="@layout/custom_spinner_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>



        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_buy_now"
            android:layout_below="@+id/rv_feature_list"
            android:text="Buy Now"
            android:fontFamily="@font/gilroy_medium"
            android:outlineProvider="none"
            android:textColor="@color/white"
            android:paddingHorizontal="@dimen/_12sdp"
            android:background="@drawable/card_rtl_bg_offer"
            android:layout_marginHorizontal="@dimen/_12sdp"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_32sdp"/>


        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/siv_view"
            android:layout_marginTop="@dimen/_10sdp"
            app:shapeAppearanceOverlay="@style/Circular"
            android:layout_below="@+id/btn_buy_now"
            android:background="@color/black"
            android:layout_marginStart="@dimen/_24sdp"
            android:layout_alignParentStart="true"
            android:layout_width="@dimen/_8sdp"
            android:layout_height="@dimen/_8sdp"/>

        <TextView
            android:layout_marginTop="@dimen/_9sdp"
            android:layout_marginEnd="@dimen/_24sdp"
            android:justificationMode="inter_word"
            android:layout_marginStart="@dimen/_3sdp"
            android:layout_below="@+id/btn_buy_now"
            android:layout_toRightOf="@+id/siv_view"
            android:textColor="@color/black"
            android:textSize="@dimen/_10ssp"
            android:fontFamily="@font/gilroy_light"
            android:text="By subscribing, you agree to Stafo's Terms &amp; Privacy Policy."
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>


    </RelativeLayout>



</androidx.constraintlayout.widget.ConstraintLayout>