<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".screens.emp.EmployeePunchInActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_emp_attend_selfie"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/app_bar_layout"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@color/primaryColorDark"
            app:elevation="0dp"
            app:layout_constraintTop_toTopOf="parent">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                tools:ignore="UseCompoundDrawables">


                <ImageView
                    android:id="@+id/image_back"
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:scaleType="fitXY"
                    android:src="@drawable/ic_back"
                    android:tint="@color/white"
                    tools:ignore="UseAppTint" />


                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:fontFamily="@font/gilroy_semi_bold"
                    android:text="Punch In"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_14ssp" />


            </RelativeLayout>


        </com.google.android.material.appbar.AppBarLayout>

        <RelativeLayout
            android:id="@+id/rl_selfie_punch_in"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_205sdp"
            android:visibility="gone"
            android:background="@color/tea_green"
            app:layout_constraintTop_toBottomOf="@id/app_bar_layout">

            <TextView
                android:id="@+id/tv_take_selfie"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Take Selfie" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/siv_emp_punch"
                android:layout_width="@dimen/_150sdp"
                android:layout_height="@dimen/_150sdp"
                android:layout_centerInParent="true"
                android:background="@color/white"
                android:scaleType="fitXY"
                android:src="@drawable/profile_picture"
                android:visibility="gone"
                app:contentPadding="@dimen/_6sdp"
                app:shapeAppearanceOverlay="@style/Circular" />


        </RelativeLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_marginBottom="@dimen/_32sdp"
            app:layout_constraintBottom_toTopOf="@+id/btn_punch_in"
            app:layout_constraintTop_toBottomOf="@id/app_bar_layout"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="0dp">
            <com.mmi.MapmyIndiaMapView
                android:id="@+id/idMapView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>




        <Button

            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginBottom="@dimen/_80sdp"
            android:id="@+id/btn_punch_in"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_12sdp"
            android:layout_marginTop="@dimen/_24sdp"
            android:background="@drawable/button_background"
            android:text="Submit" />


    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>