<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <RelativeLayout
        android:id="@+id/rl_emp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_5sdp"
        android:layout_marginEnd="@dimen/_10sdp"
        android:layout_marginBottom="@dimen/_5sdp"
        android:background="@drawable/custom_item_card_bg"
        android:paddingHorizontal="@dimen/_10sdp"
        android:paddingVertical="@dimen/_12sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">


        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/llc_edit_delete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/txt_shift_name"
            android:layout_marginTop="@dimen/_8sdp"
            android:layout_alignParentEnd="true"
            android:orientation="horizontal">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/item_edit"
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:layout_alignParentEnd="true"
                android:background="@color/tea_green"
                android:src="@drawable/edit_pen"
                android:tint="@color/app_theme_colour"
                app:contentPadding="@dimen/_5sdp"
                app:shapeAppearanceOverlay="@style/Circular" />

            <View
                android:layout_width="@dimen/_16sdp"
                android:layout_height="@dimen/_10sdp"
                android:layout_gravity="center_horizontal" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/item_delete"
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:layout_alignParentEnd="true"
                android:background="@color/tea_green"
                android:src="@drawable/delete"
                android:tint="@color/pastel_red"
                app:contentPadding="@dimen/_3sdp"
                app:shapeAppearanceOverlay="@style/Circular" />

        </androidx.appcompat.widget.LinearLayoutCompat>


        <TextView
            android:id="@+id/txt_shift_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_marginStart="@dimen/_6sdp"
            android:layout_toLeftOf="@+id/llc_edit_delete"
            android:fontFamily="@font/gilroy_regular"
            android:text=""
            android:textColor="@color/black"
            android:textSize="@dimen/_12ssp" />


        <ImageView
            android:id="@+id/iv_time"
            android:layout_marginStart="@dimen/_6sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:layout_width="@dimen/_16sdp"
            android:layout_height="@dimen/_16sdp"
            android:layout_below="@+id/txt_shift_name"
            android:src="@drawable/ic_time"
            android:tint="@color/gray_colour"
            tools:ignore="UseAppTint" />


        <TextView
            android:id="@+id/txt_shift_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/txt_shift_name"
            android:layout_marginTop="@dimen/_8sdp"
            android:layout_marginStart="@dimen/_6sdp"
            android:layout_toRightOf="@+id/iv_time"
            android:fontFamily="@font/gilroy_regular"
            android:text=""
            android:textColor="@color/black"
            android:textSize="@dimen/_12ssp" />
        <ImageView
            android:id="@+id/iv_days"
            android:layout_marginStart="@dimen/_6sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:layout_width="@dimen/_16sdp"
            android:layout_height="@dimen/_16sdp"
            android:padding="@dimen/_1sdp"
            android:layout_below="@+id/llc_edit_delete"
            android:src="@drawable/ic_calendar_month"
            android:tint="@color/gray_colour"
            tools:ignore="UseAppTint" />

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/llc_edit_delete"
            android:layout_toRightOf="@+id/iv_time"
            android:layout_marginTop="@dimen/_8sdp"
            android:layout_marginStart="@dimen/_6sdp"
            android:layout_alignParentEnd="true">
            <TextView
                android:id="@+id/tv_days"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gilroy_regular"
                android:text="Sun,Mon,Tus,Wed,Thu,Fri,Sat"
                android:textColor="@color/black"
                android:textSize="@dimen/_12ssp" />


        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView

            android:orientation="horizontal"
            tools:listitem="@layout/working_days_child_layout"
            android:paddingHorizontal="@dimen/_6sdp"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

    </RelativeLayout>


</androidx.constraintlayout.widget.ConstraintLayout>


