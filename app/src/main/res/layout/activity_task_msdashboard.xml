<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_header"
    android:orientation="vertical"
    tools:context=".screens.tms.TaskMSDashboard">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_12sdp"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6sdp"
            android:padding="@dimen/_4sdp"
            android:src="@drawable/ic_back" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/gilroy_semi_bold"
                android:padding="@dimen/_6sdp"
                android:text="Task"
                android:textColor="@color/white"
                android:textSize="@dimen/_14ssp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddTask"
                android:layout_width="@dimen/_38sdp"
                android:layout_height="@dimen/_38sdp"
                android:backgroundTint="@color/primaryColorDark"
                android:gravity="center"
                android:text="+"
                android:textColor="@color/white"
                android:textSize="@dimen/_14ssp"
                app:cornerRadius="@dimen/_6sdp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Summary Cards -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center">

        <include
            android:id="@+id/totalTask"
            layout="@layout/item_summary_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_6sdp"
            android:layout_weight="1" />

        <include
            android:id="@+id/inProgressTask"
            layout="@layout/item_summary_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_6sdp"
            android:layout_weight="1" />

        <include
            android:id="@+id/completeTask"
            layout="@layout/item_summary_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_6sdp"
            android:layout_weight="1" />

        <include
            android:id="@+id/overDuaTask"
            layout="@layout/item_summary_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_6sdp"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/top_rounded_bg"
        android:orientation="vertical">

        <!-- Tabs -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginTop="@dimen/_12sdp"
            android:orientation="horizontal"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">


                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_all_tasks"
                    android:layout_width="@dimen/_100sdp"
                    android:layout_height="@dimen/_38sdp"
                    android:layout_margin="@dimen/_2sdp"
                    android:background="@drawable/card_rtl_bg_offer"
                    android:fontFamily="@font/gilroy_semi_bold"
                    android:gravity="center"
                    android:text="All Tasks"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_11ssp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_in_progress"
                    android:layout_width="@dimen/_100sdp"
                    android:layout_height="@dimen/_34sdp"
                    android:layout_margin="@dimen/_2sdp"
                    android:background="@drawable/card_rtl_bg_offer"
                    android:fontFamily="@font/gilroy_semi_bold"
                    android:gravity="center"
                    android:text="In Progress"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_11ssp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_pending"
                    android:layout_width="@dimen/_100sdp"
                    android:layout_height="@dimen/_34sdp"
                    android:layout_margin="@dimen/_2sdp"
                    android:background="@drawable/card_rtl_bg_offer"
                    android:fontFamily="@font/gilroy_semi_bold"
                    android:gravity="center"
                    android:text="Pending"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_11ssp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_completed"
                    android:layout_width="@dimen/_100sdp"
                    android:layout_height="@dimen/_34sdp"
                    android:layout_margin="@dimen/_2sdp"
                    android:background="@drawable/card_rtl_bg_offer"
                    android:fontFamily="@font/gilroy_semi_bold"
                    android:gravity="center"
                    android:text="Completed"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_11ssp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_overdue"
                    android:layout_width="@dimen/_100sdp"
                    android:layout_height="@dimen/_34sdp"
                    android:layout_margin="@dimen/_2sdp"
                    android:background="@drawable/card_rtl_bg_offer"
                    android:fontFamily="@font/gilroy_semi_bold"
                    android:gravity="center"
                    android:text="Overdue"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_11ssp"
                    android:textStyle="bold" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Task List -->


        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerTasks"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/_12sdp"
                android:layout_weight="1"
                tools:listitem="@layout/item_task_card_layout" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>



    </LinearLayout>


</LinearLayout>
