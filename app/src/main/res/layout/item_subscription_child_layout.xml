<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <RelativeLayout
        android:id="@+id/rtl_change_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_12sdp"
        android:layout_marginTop="@dimen/_12sdp"
        android:background="@drawable/card_rtl_bg_offer3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_plan"
            android:elevation="1dp"
            android:padding="@dimen/_4sdp"
            android:layout_marginStart="@dimen/_14sdp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_width="@dimen/_28sdp"
            android:layout_height="@dimen/_28sdp"/>

        <View
            android:id="@+id/view"
            android:background="@drawable/custom_plan_view_bg3"
            android:layout_width="@dimen/_24sdp"
            android:layout_height="@dimen/_85sdp"/>

        <RelativeLayout
            android:paddingVertical="@dimen/_10sdp"
            android:paddingHorizontal="@dimen/_10sdp"
            android:layout_marginStart="@dimen/_28sdp"
            android:layout_toRightOf="@+id/view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/tv_plan_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gilroy_semi_bold"
                android:text="Monthly"
                android:textColor="@color/black"
                android:textSize="@dimen/_12ssp" />


            <TextView
                android:id="@+id/tv_plan_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/tv_plan_name"
                android:layout_marginTop="@dimen/_8sdp"
                android:fontFamily="@font/gilroy_regular"
                android:text="\u20B9 999/month"
                android:textColor="@color/black"
                android:textSize="@dimen/_12ssp" />

            <TextView
                android:id="@+id/tv_view_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/tv_plan_price"
                android:layout_marginTop="@dimen/_8sdp"
                android:fontFamily="@font/gilroy_regular"
                android:text="View Details"
                android:textColor="@color/blue_800"
                android:textSize="@dimen/_12ssp" />


            <TextView
                android:id="@+id/tv_get_now"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:drawableEnd="@drawable/resize_arrow_right"
                android:fontFamily="@font/gilroy_regular"
                android:layout_below="@+id/tv_plan_price"
                android:layout_marginTop="@dimen/_8sdp"
                android:text="Choose Plan"
                android:textColor="@color/black"
                android:textSize="@dimen/_12ssp" />
        </RelativeLayout>



    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>